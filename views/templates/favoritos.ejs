<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Favoritos</title>
    <link rel="stylesheet" href="/css/style2.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body>

<header>
    <a href="/home">
        <img src="/IMG/logo.png" alt="Logo" class="logo" id="logo">
    </a>

    <nav>

        <input type="checkbox" id="check">

        <label for="check">
            <i class="fas fa-bars" id="btn"></i>
            <i class="fas fa-times" id="cancel"></i>
        </label>

        <div class="sidebar-overlay" id="overlay"></div>

        <div class="sidebar">

            <header>
                <img src="/IMG/logo.png" class="logo-sidebar">
            </header>

            <a href="/home" class="link-sidebar">
                <i class="fas fa-home"></i><span>Home</span>
            </a>

            <a href="/favoritos" class="link-sidebar active">
                <i class="fas fa-heart"></i><span>Favoritos</span>
            </a>

            <a href="/lista-cinemas" class="link-sidebar">
                <i class="fas fa-film"></i><span>Cinemas</span>
            </a>

            <a href="/config" class="link-sidebar">
                <i class="fas fa-cog"></i><span>Configurações</span>
            </a>

            <div class="user-section">
                <div class="user-info">
                    <i class="fas fa-user-circle"></i>
                    <span id="username"><%= currentUser.username %></span>
                </div>

                <a href="/auth/logout" class="logout-btn">
                    <i class="fas fa-sign-out-alt"></i><span>Sair</span>
                </a>
            </div>

        </div>
    </nav>
</header>

<main id="content-area">
    <section class="boas-vindas">
        <h2>Filmes Favoritos</h2>
    </section>

    <section class="filmes">
        <% if (favoritos && favoritos.length > 0) { %>
            <% favoritos.forEach(filme => { %>
                <a href="/filmes/detalhes/<%= filme._id %>" class="filme-card">
                    <img src="<%= filme.poster %>" alt="<%= filme.titulo %>">
                    <h4><%= filme.titulo %></h4>
                    <p><%= filme.diretor %></p>
                </a>
            <% }) %>
        <% } else { %>
            <p>Nenhum filme favorito encontrado.</p>
        <% } %>
    </section>

</main>

<footer>
    <p>&copy; PopFlix</p>
</footer>

<script src="/JS/config.js"></script>

</body>
</html>