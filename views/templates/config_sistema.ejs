<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="IMG/icon.png" class="icon" alt="icon">
    <title>Configurações</title>
    <link rel="stylesheet" href="css/style2.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Open Sans', sans-serif;
            background-color: #ffffff;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 900px;
            margin: 50px auto;
            background: white;
            border-radius: 15px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            padding: 40px;
        }

        .tabs {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .tab-btn {
            background: #f1f1f1;
            border: none;
            padding: 10px 25px;
            border-radius: 30px;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .tab-btn.active {
            background: #c4002f;
            color: white;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
            animation: fadeIn 0.4s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .section-header h2 {
            color: #c4002f;
            margin-bottom: 10px;
        }

        .add-btn {
            background: #c4002f;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            cursor: pointer;
            transition: 0.3s;
        }

        .add-btn:hover {
            background: #a80027;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th, td {
            text-align: left;
            padding: 10px;
            border-bottom: 1px solid #eee;
        }

        th {
            color: #333;
        }

        /* ---------- Popup ---------- */
        .popup {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
            z-index: 999;
        }

        .popup-content {
            background: white;
            border-radius: 15px;
            padding: 30px;
            width: 400px;
            box-shadow: 0 0 15px rgba(0,0,0,0.2);
        }

        .popup-content h3 {
            color: #c4002f;
            margin-bottom: 20px;
            text-align: center;
        }

        .popup-content input,
        .popup-content textarea {
            width: 100%;
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 15px;
        }

        .popup-buttons {
            display: flex;
            justify-content: space-between;
        }

        .popup-buttons button {
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            cursor: pointer;
        }

        .save-btn {
            background: #c4002f;
            color: white;
        }

        .cancel-btn {
            background: #ccc;
        }
    </style>
</head>
<body>
    <header>
        <a href="Index.html">
            <img src="IMG/logo.png" alt="Logo" class="logo" id="logo">
        </a>
        <nav>
            <!-- Menu Lateral -->
            <input type="checkbox" id="check">

            <!-- Botões de controle -->
            <label for="check">
                <i class="fas fa-bars" id="btn"></i>
                <i class="fas fa-times" id="cancel"></i>
            </label>

            <!-- Overlay -->
            <div class="sidebar-overlay" id="overlay"></div>    

            <div class="sidebar">
                <header>
                    <img src="IMG/logo.png" alt="Logo Simoldes" class="logo-sidebar">
                </header>
                    
                <a href="index.html" class="link-sidebar">
                    <i class="fas fa-home"></i>
                    <span>Home</span>
                </a>
                
                <a href="#" class="link-sidebar" onclick="showTable('production')">
                    <i class="fas fa-industry"></i>
                    <span>Favoritos</span>
                </a>
                
                <a href="#" class="link-sidebar" onclick="showTable('finished')">
                    <i class="fas fa-check-circle"></i>
                    <span>Cinemas</span> 
                </a>
                
                <a href="#" class="link-sidebar" onclick="showSettings()">
                    <i class="fas fa-cog"></i>
                    <span>Configurações</span>
                </a>

                <div class="user-section">
                    <div class="user-info">
                        <i class="fas fa-user-circle"></i>
                        <span id="username">Nome do Usuário</span>
                    </div>
                    <a href="#" class="logout-btn" onclick="logout()">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Sair</span>
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main id="content-area">
        <h2>Configurações do Sistema</h2>
        <div class="container">

            <div class="tabs">
                <button class="tab-btn active" data-tab="usuarios">Usuários</button>
                <button class="tab-btn" data-tab="cinemas">Cinemas</button>
                <button class="tab-btn" data-tab="filmes">Filmes</button>
            </div>

            <!-- Usuários -->
            <div id="usuarios" class="tab-content active">
                <div class="section-header">
                    <h2>Gerenciar Usuários</h2>
                    <button class="add-btn" onclick="abrirPopup('popupUsuario')">Adicionar Usuário</button>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Usuário</th>
                            <th>E-mail</th>
                            <th>Senha</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <!-- Cinemas -->
            <div id="cinemas" class="tab-content">
                <div class="section-header">
                    <h2>Gerenciar Cinemas</h2>
                    <button class="add-btn" onclick="abrirPopup('popupCinema')">Adicionar Cinema</button>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Endereço</th>
                            <th>Foto</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <!-- Filmes -->
            <div id="filmes" class="tab-content">
                <div class="section-header">
                    <h2>Gerenciar Filmes</h2>
                    <button class="add-btn" onclick="abrirPopup('popupFilme')">Adicionar Filme</button>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Descrição</th>
                            <th>Gênero</th>
                            <th>Ano</th>
                            <th>Diretor</th>
                            <th>Sinopse</th>
                            <th>Poster</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <!-- Popups -->
        <div class="popup" id="popupUsuario">
            <div class="popup-content">
                <h3>Adicionar Usuário</h3>
                <input type="text" placeholder="Nome de Usuário">
                <input type="email" placeholder="E-mail">
                <input type="password" placeholder="Senha">
                <div class="popup-buttons">
                    <button class="cancel-btn" onclick="fecharPopup('popupUsuario')">Cancelar</button>
                    <button class="save-btn">Salvar</button>
                </div>
            </div>
        </div>

        <div class="popup" id="popupCinema">
            <div class="popup-content">
                <h3>Adicionar Cinema</h3>
                <input type="text" placeholder="Nome do Cinema">
                <input type="text" placeholder="Localização">
                <input type="file" accept="image/*">
                <div class="popup-buttons">
                    <button class="cancel-btn" onclick="fecharPopup('popupCinema')">Cancelar</button>
                    <button class="save-btn">Salvar</button>
                </div>
            </div>
        </div>

        <div class="popup" id="popupFilme">
            <div class="popup-content">
                <h3>Adicionar Filme</h3>
                <input type="text" placeholder="Título">
                <input type="text" placeholder="Descrição">
                <input type="text" placeholder="Gênero">
                <input type="text" placeholder="Ano">
                <input type="text" placeholder="Diretor">
                <textarea rows="3" placeholder="Sinopse"></textarea>
                <input type="file" accept="image/*">
                <div class="popup-buttons">
                    <button class="cancel-btn" onclick="fecharPopup('popupFilme')">Cancelar</button>
                    <button class="save-btn">Salvar</button>
                </div>
            </div>
        </div>
    </main>

    <footer>
        <p>&copy; PopFlix.</p>
    </footer>

    <script>
        // ---------- Menu lateral ----------
        const check = document.getElementById('check');
        const overlay = document.getElementById('overlay');
        const sidebar = document.querySelector('.sidebar');
        const btn = document.getElementById('btn');

        overlay.addEventListener('click', function() {
            check.checked = false;
            updateSidebarState();
        });

        function updateSidebarState() {
            if (check.checked) {
                overlay.style.display = 'block';
                setTimeout(() => {
                    overlay.style.opacity = '1';
                    overlay.style.visibility = 'visible';
                }, 10);
            } else {
                overlay.style.opacity = '0';
                overlay.style.visibility = 'hidden';
                setTimeout(() => {
                    overlay.style.display = 'none';
                }, 300);
            }
        }

        check.addEventListener('change', updateSidebarState);

        document.addEventListener('click', function(e) {
            if (check.checked && 
                !sidebar.contains(e.target) && 
                e.target !== check && 
                e.target !== btn && 
                !btn.contains(e.target)) {
                setTimeout(() => {
                    check.checked = false;
                    updateSidebarState();
                }, 10);
            }
        });

    </script>
    <script>
        // ---------- Tabs ----------
        const tabs = document.querySelectorAll('.tab-btn');
        const contents = document.querySelectorAll('.tab-content');

        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                tabs.forEach(t => t.classList.remove('active'));
                contents.forEach(c => c.classList.remove('active'));
                tab.classList.add('active');
                document.getElementById(tab.dataset.tab).classList.add('active');
            });
        });

        // ---------- Popups ----------
        function abrirPopup(id) {
            document.getElementById(id).style.display = 'flex';
        }

        function fecharPopup(id) {
            document.getElementById(id).style.display = 'none';
        }

        window.onclick = function(e) {
            const popups = document.querySelectorAll('.popup');
            popups.forEach(p => {
                if (e.target === p) p.style.display = 'none';
            });
        };
    </script>
</body>
</html>