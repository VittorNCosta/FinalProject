<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/IMG/icon.png" class="icon" alt="icon">
    <title>Configurações</title>

    <!-- CSS principal -->
    <link rel="stylesheet" href="/css/style2.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            font-family: 'Open Sans', sans-serif;
            background-color: #ffffff;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 900px;
            margin: 50px auto;
            background: white;
            border-radius: 15px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            padding: 40px;
        }

        .tabs {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .tab-btn {
            background: #f1f1f1;
            border: none;
            padding: 10px 25px;
            border-radius: 30px;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .tab-btn.active {
            background: #c4002f;
            color: white;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
            animation: fadeIn 0.4s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .section-header h2 {
            color: #c4002f;
            margin-bottom: 10px;
        }

        .add-btn {
            background: #c4002f;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            cursor: pointer;
            transition: 0.3s;
        }

        .add-btn:hover {
            background: #a80027;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th, td {
            text-align: left;
            padding: 10px;
            border-bottom: 1px solid #eee;
        }

        th {
            color: #333;
        }

        /* ---------- Popup ---------- */
        .popup {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
            z-index: 999;
        }

        .popup-content {
            background: white;
            border-radius: 15px;
            padding: 30px;
            width: 400px;
            box-shadow: 0 0 15px rgba(0,0,0,0.2);
        }

        .popup-content h3 {
            color: #c4002f;
            margin-bottom: 20px;
            text-align: center;
        }

        .popup-content input,
        .popup-content textarea {
            width: 100%;
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 15px;
        }

        .popup-buttons {
            display: flex;
            justify-content: space-between;
        }

        .popup-buttons button {
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            cursor: pointer;
        }

        .save-btn {
            background: #c4002f;
            color: white;
        }

        .cancel-btn {
            background: #ccc;
        }
    </style>
</head>
<body>
    <header>
        <a href="/home">
            <img src="/IMG/logo.png" alt="Logo" class="logo" id="logo">
        </a>
        <nav>
            <!-- Menu Lateral -->
            <input type="checkbox" id="check">

            <!-- Botões de controle -->
            <label for="check">
                <i class="fas fa-bars" id="btn"></i>
                <i class="fas fa-times" id="cancel"></i>
            </label>

            <!-- Overlay -->
            <div class="sidebar-overlay" id="overlay"></div>    

            <div class="sidebar">
                <header>
                    <img src="/IMG/logo.png" alt="Logo PopFlix" class="logo-sidebar">
                </header>
                    
                <a href="/home" class="link-sidebar">
                    <i class="fas fa-home"></i>
                    <span>Home</span>
                </a>
                
                <a href="/favoritos" class="link-sidebar">
                    <i class="fas fa-heart"></i>
                    <span>Favoritos</span>
                </a>
                
                <a href="/lista-cinemas" class="link-sidebar">
                    <i class="fas fa-film"></i>
                    <span>Cinemas</span> 
                </a>
                
                <a href="/config" class="link-sidebar active">
                    <i class="fas fa-cog"></i>
                    <span>Configurações</span>
                </a>

                <div class="user-section">
                    <div class="user-info">
                        <i class="fas fa-user-circle"></i>
                        <span id="username"><%= (currentUser && currentUser.username) || "Nome do Usuário" %></span>
                    </div>
                    <a href="/auth/logout" class="logout-btn">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Sair</span>
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main id="content-area">
        <h2>Configurações do Sistema</h2>
        <div class="container">

            <div class="tabs">
                <button class="tab-btn active" data-tab="usuarios">Usuários</button>
                <button class="tab-btn active" data-tab="cinemas">Cinemas</button>
                <button class="tab-btn" data-tab="filmes">Filmes</button>
            </div>

            <!-- Usuários -->
            <div id="usuarios" class="tab-content active">
                <div class="section-header">
                    <h2>Gerenciar Usuários</h2>
                    <button class="add-btn" id="btnAddUsuario">Adicionar Usuário</button>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Usuário</th>
                            <th>E-mail</th>
                            <th>Senha</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody id="usuarios-tbody"></tbody>
                </table>
            </div>

            <!-- Cinemas -->
            <div id="cinemas" class="tab-content active">
                <div class="section-header">
                    <h2>Gerenciar Cinemas</h2>
                    <button class="add-btn" id="btnAddCinema">Adicionar Cinema</button>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Endereço</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody id="cinemas-tbody"></tbody>
                </table>
            </div>

            <!-- Filmes -->
            <div id="filmes" class="tab-content">
                <div class="section-header">
                    <h2>Gerenciar Filmes</h2>
                    <button class="add-btn" id="btnAddFilme">Adicionar Filme</button>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Descrição</th>
                            <th>Gênero</th>
                            <th>Ano</th>
                            <th>Diretor</th>
                            <th>Sinopse</th>
                            <th>Poster</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody id="filmes-tbody"></tbody>
                </table>
            </div>
        </div>

        <!-- Popup Usuário -->
        <div class="popup" id="popupUsuario">
            <div class="popup-content">
                <h3 id="tituloPopupUsuario">Adicionar Usuário</h3>
                <input id="usuarioId" type="hidden">
                <input id="usuarioNome" type="text" placeholder="Nome de Usuário">
                <input id="usuarioEmail" type="email" placeholder="E-mail">
                <input id="usuarioSenha" type="password" placeholder="Senha">
                <div class="popup-buttons">
                    <button class="cancel-btn" data-popup-cancel="popupUsuario">Cancelar</button>
                    <button class="save-btn" id="btnSalvarUsuario">Salvar</button>
                </div>
            </div>
        </div>

        <!-- Popup Cinema -->
        <div class="popup" id="popupCinema">
            <div class="popup-content">
                <h3 id="tituloPopupCinema">Adicionar Cinema</h3>
                <input id="cinemaId" type="hidden">
                <input id="cinemaNome" type="text" placeholder="Nome do Cinema">
                <input id="cinemaEndereco" type="text" placeholder="Endereço">
                <input id="cinemaFoto" type="text" placeholder="URL da imagem do cinema">
                <div class="popup-buttons">
                    <button class="cancel-btn" data-popup-cancel="popupCinema">Cancelar</button>
                    <button class="save-btn" id="btnSalvarCinema">Salvar</button>
                </div>
            </div>
        </div>

        <!-- Popup Filme -->
        <div class="popup" id="popupFilme">
            <div class="popup-content">
                <h3 id="tituloPopupFilme">Adicionar Filme</h3>
                <input id="filmeId" type="hidden">
                <input id="filmeTitulo" type="text" placeholder="Título">
                <input id="filmeDescricao" type="text" placeholder="Descrição">
                <input id="filmeGenero" type="text" placeholder="Gênero">
                <input id="filmeAno" type="text" placeholder="Ano">
                <input id="filmeDiretor" type="text" placeholder="Diretor">
                <textarea id="filmeSinopse" rows="3" placeholder="Sinopse"></textarea>
                <input id="filmePoster" type="text" placeholder="Poster (URL da imagem)">
                <div class="popup-buttons">
                    <button class="cancel-btn" data-popup-cancel="popupFilme">Cancelar</button>
                    <button class="save-btn" id="btnSalvarFilme">Salvar</button>
                </div>
            </div>
        </div>
    </main>

    <footer>
        <p>&copy; PopFlix.</p>
    </footer>

    <!-- ======================== JS ======================== -->
    <script>
    document.addEventListener("DOMContentLoaded", () => {
        /* ================= MENU LATERAL ================= */
        const check   = document.getElementById('check');
        const overlay = document.getElementById('overlay');
        const sidebar = document.querySelector('.sidebar');
        const btnMenu = document.getElementById('btn');

        function updateSidebarState() {
            if (check.checked) {
                overlay.style.display = 'block';
                setTimeout(() => {
                    overlay.style.opacity = '1';
                    overlay.style.visibility = 'visible';
                }, 10);
            } else {
                overlay.style.opacity = '0';
                overlay.style.visibility = 'hidden';
                setTimeout(() => {
                    overlay.style.display = 'none';
                }, 300);
            }
        }

        if (overlay) {
            overlay.addEventListener('click', () => {
                check.checked = false;
                updateSidebarState();
            });
        }

        if (check) {
            check.addEventListener('change', updateSidebarState);
        }

        document.addEventListener('click', (e) => {
            if (
                check.checked &&
                !sidebar.contains(e.target) &&
                e.target !== check &&
                e.target !== btnMenu &&
                !btnMenu.contains(e.target)
            ) {
                setTimeout(() => {
                    check.checked = false;
                    updateSidebarState();
                }, 10);
            }
        });

        updateSidebarState();

        /* ================= TABS ================= */
        const tabs    = document.querySelectorAll('.tab-btn');
        const contents = document.querySelectorAll('.tab-content');

        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                tabs.forEach(t => t.classList.remove('active'));
                contents.forEach(c => c.classList.remove('active'));

                tab.classList.add('active');
                const alvo = document.getElementById(tab.dataset.tab);
                if (alvo) alvo.classList.add('active');
            });
        });

        /* ================= POPUPS (GENÉRICO) ================= */
        function abrirPopup(id) {
            const popup = document.getElementById(id);
            if (popup) popup.style.display = 'flex';
        }

        function fecharPopup(id) {
            const popup = document.getElementById(id);
            if (popup) popup.style.display = 'none';
        }

        // Fecha popup clicando no fundo
        document.querySelectorAll('.popup').forEach(popup => {
            popup.addEventListener('click', (e) => {
                if (e.target === popup) {
                    popup.style.display = 'none';
                }
            });
        });

        // Botões de cancelar genéricos
        document.querySelectorAll('[data-popup-cancel]').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = btn.getAttribute('data-popup-cancel');
                fecharPopup(id);
            });
        });

        /* ================== USUÁRIOS ================== */
        let modoUsuario = "criar"; // 'criar' ou 'editar'

        const tbodyUsuarios   = document.getElementById("usuarios-tbody");
        const btnAddUsuario   = document.getElementById("btnAddUsuario");
        const btnSalvarUsuario = document.getElementById("btnSalvarUsuario");
        const tituloPopupUsuario = document.getElementById("tituloPopupUsuario");

        function limparFormularioUsuario() {
            document.getElementById("usuarioId").value    = "";
            document.getElementById("usuarioNome").value  = "";
            document.getElementById("usuarioEmail").value = "";
            document.getElementById("usuarioSenha").value = "";
        }

        if (btnAddUsuario) {
            btnAddUsuario.addEventListener("click", () => {
                modoUsuario = "criar";
                tituloPopupUsuario.textContent = "Adicionar Usuário";
                limparFormularioUsuario();
                abrirPopup("popupUsuario");
            });
        }

        if (btnSalvarUsuario) {
            btnSalvarUsuario.addEventListener("click", async () => {
                if (modoUsuario === "criar") {
                    await salvarUsuario();
                } else {
                    await salvarEdicaoUsuario();
                }
            });
        }

        async function salvarUsuario() {
            const nome  = document.getElementById("usuarioNome").value.trim();
            const email = document.getElementById("usuarioEmail").value.trim();
            const senha = document.getElementById("usuarioSenha").value.trim();

            if (!nome || !email || !senha) {
                alert("Preencha nome, e-mail e senha.");
                return;
            }

            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                alert("E-mail inválido.");
                return;
            }

            if (senha.length < 6) {
                alert("A senha deve ter pelo menos 6 caracteres.");
                return;
            }

            const data = { nome, email, senha };

            try {
                const response = await fetch("/users", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (!response.ok) {
                    alert(result.error || "Erro ao salvar usuário.");
                    return;
                }

                alert("Usuário cadastrado com sucesso!");
                fecharPopup("popupUsuario");
                carregarUsuarios();
            } catch (error) {
                console.error(error);
                alert("Erro ao salvar usuário.");
            }
        }

        async function carregarUsuarios() {
            if (!tbodyUsuarios) return;

            tbodyUsuarios.innerHTML = "<tr><td colspan='4'>Carregando...</td></tr>";

            try {
                const response = await fetch("/users");
                const users = await response.json();

                tbodyUsuarios.innerHTML = "";

                if (!users || users.length === 0) {
                    tbodyUsuarios.innerHTML = "<tr><td colspan='4'>Nenhum usuário cadastrado.</td></tr>";
                    return;
                }

                users.forEach(user => {
                    const tr = document.createElement("tr");
                    tr.innerHTML = `
                        <td>${user.nome}</td>
                        <td>${user.email}</td>
                        <td>••••••••</td>
                        <td>
                            <button class="btn-editar-usuario" data-id="${user._id}">Editar</button>
                            <button class="btn-deletar-usuario" data-id="${user._id}">Excluir</button>
                        </td>
                    `;
                    tbodyUsuarios.appendChild(tr);
                });

            } catch (err) {
                console.error(err);
                tbodyUsuarios.innerHTML = "<tr><td colspan='4'>Erro ao carregar usuários.</td></tr>";
            }
        }

        // Delegação de eventos para editar/deletar usuário
        if (tbodyUsuarios) {
            tbodyUsuarios.addEventListener("click", async (e) => {
                const btn = e.target;
                const id = btn.getAttribute("data-id");
                if (!id) return;

                if (btn.classList.contains("btn-editar-usuario")) {
                    await editarUsuario(id);
                } else if (btn.classList.contains("btn-deletar-usuario")) {
                    await deletarUsuario(id);
                }
            });
        }

        async function editarUsuario(id) {
            try {
                const response = await fetch(`/users/${id}`);
                const user = await response.json();

                document.getElementById("usuarioId").value    = user._id;
                document.getElementById("usuarioNome").value  = user.nome || "";
                document.getElementById("usuarioEmail").value = user.email || "";
                document.getElementById("usuarioSenha").value = "";

                modoUsuario = "editar";
                tituloPopupUsuario.textContent = "Editar Usuário";
                abrirPopup("popupUsuario");
            } catch (err) {
                console.error(err);
                alert("Erro ao carregar usuário para edição.");
            }
        }

        async function salvarEdicaoUsuario() {
            const id    = document.getElementById("usuarioId").value;
            const nome  = document.getElementById("usuarioNome").value.trim();
            const email = document.getElementById("usuarioEmail").value.trim();
            const senha = document.getElementById("usuarioSenha").value.trim();

            if (!nome || !email || !senha) {
                alert("Todos os campos são obrigatórios!");
                return;
            }

            try {
                const response = await fetch(`/users/${id}`, {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ nome, email, senha })
                });

                const result = await response.json();

                if (!response.ok) {
                    alert(result.error || "Erro ao atualizar.");
                    return;
                }

                alert("Usuário atualizado!");
                fecharPopup("popupUsuario");
                carregarUsuarios();

            } catch (error) {
                console.error(error);
                alert("Erro ao atualizar usuário.");
            }
        }

        async function deletarUsuario(id) {
            if (!confirm("Tem certeza que deseja excluir este usuário?")) return;

            try {
                const response = await fetch(`/users/${id}`, { method: "DELETE" });

                if (!response.ok) {
                    const result = await response.json();
                    alert(result.error || "Erro ao excluir usuário.");
                    return;
                }

                alert("Usuário excluído com sucesso!");
                carregarUsuarios();
            } catch (error) {
                console.error(error);
                alert("Erro ao excluir usuário.");
            }
        }

        /* ================== FILMES ================== */
        const tbodyFilmes      = document.getElementById("filmes-tbody");
        const btnAddFilme      = document.getElementById("btnAddFilme");
        const btnSalvarFilme   = document.getElementById("btnSalvarFilme");
        const tituloPopupFilme = document.getElementById("tituloPopupFilme");
        let modoFilme = "criar";

        function limparFormularioFilme() {
            document.getElementById("filmeId").value        = "";
            document.getElementById("filmeTitulo").value    = "";
            document.getElementById("filmeDescricao").value = "";
            document.getElementById("filmeGenero").value    = "";
            document.getElementById("filmeAno").value       = "";
            document.getElementById("filmeDiretor").value   = "";
            document.getElementById("filmeSinopse").value   = "";
            document.getElementById("filmePoster").value    = "";
        }

        if (btnAddFilme) {
            btnAddFilme.addEventListener("click", () => {
                modoFilme = "criar";
                tituloPopupFilme.textContent = "Adicionar Filme";
                limparFormularioFilme();
                abrirPopup("popupFilme");
            });
        }

        if (btnSalvarFilme) {
            btnSalvarFilme.addEventListener("click", async () => {
                if (modoFilme === "criar") {
                    await salvarFilme();
                } else {
                    await salvarEdicaoFilme();
                }
            });
        }

        async function salvarFilme() {
            const id        = document.getElementById("filmeId").value;
            const titulo    = document.getElementById("filmeTitulo").value.trim();
            const descricao = document.getElementById("filmeDescricao").value.trim();
            const genero    = document.getElementById("filmeGenero").value.trim();
            const ano       = document.getElementById("filmeAno").value.trim();
            const diretor   = document.getElementById("filmeDiretor").value.trim();
            const sinopse   = document.getElementById("filmeSinopse").value.trim();
            const poster    = document.getElementById("filmePoster").value.trim();

            if (!titulo || !genero || !ano) {
                alert("Preencha pelo menos Título, Gênero e Ano.");
                return;
            }

            const filme = { titulo, descricao, genero, ano, diretor, sinopse, poster };

            try {
                const url = id ? `/filmes/${id}` : "/filmes";
                const method = id ? "PUT" : "POST";

                const response = await fetch(url, {
                    method,
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(filme)
                });

                const result = await response.json();

                if (!response.ok) {
                    alert(result.error || "Erro ao salvar filme.");
                    return;
                }

                alert(id ? "Filme atualizado com sucesso!" : "Filme cadastrado com sucesso!");
                fecharPopup("popupFilme");
                carregarFilmes();

            } catch (error) {
                console.error(error);
                alert("Erro ao salvar filme.");
            }
        }

        async function carregarFilmes() {
            if (!tbodyFilmes) return;

            tbodyFilmes.innerHTML = "<tr><td colspan='8'>Carregando...</td></tr>";

            try {
                const response = await fetch("/filmes");
                const filmes = await response.json();

                tbodyFilmes.innerHTML = "";

                if (!filmes || filmes.length === 0) {
                    tbodyFilmes.innerHTML = "<tr><td colspan='8'>Nenhum filme cadastrado.</td></tr>";
                    return;
                }

                filmes.forEach(filme => {
                    const tr = document.createElement("tr");
                    tr.innerHTML = `
                        <td>${filme.titulo || ""}</td>
                        <td>${filme.descricao || ""}</td>
                        <td>${filme.genero || ""}</td>
                        <td>${filme.ano || ""}</td>
                        <td>${filme.diretor || ""}</td>
                        <td>${filme.sinopse || ""}</td>
                        <td>
                            ${filme.poster 
                                ? `<img src="${filme.poster}" style="width: 60px; height: auto; border-radius: 4px;" />`
                                : "-"
                            }
                        </td>
                        <td>
                            <button class="btn-editar-filme" data-id="${filme._id}">Editar</button>
                            <button class="btn-deletar-filme" data-id="${filme._id}">Excluir</button>
                        </td>
                    `;
                    tbodyFilmes.appendChild(tr);
                });

            } catch (error) {
                console.error(error);
                tbodyFilmes.innerHTML = "<tr><td colspan='8'>Erro ao carregar filmes.</td></tr>";
            }
        }

        if (tbodyFilmes) {
            tbodyFilmes.addEventListener("click", async (e) => {
                const btn = e.target;
                const id = btn.getAttribute("data-id");
                if (!id) return;

                if (btn.classList.contains("btn-editar-filme")) {
                    await editarFilme(id);
                } else if (btn.classList.contains("btn-deletar-filme")) {
                    await deletarFilme(id);
                }
            });
        }

        async function editarFilme(id) {
            try {
                const response = await fetch(`/filmes/${id}`);
                const filme = await response.json();

                document.getElementById("filmeId").value          = filme._id;
                document.getElementById("filmeTitulo").value      = filme.titulo    || "";
                document.getElementById("filmeDescricao").value   = filme.descricao || "";
                document.getElementById("filmeGenero").value      = filme.genero    || "";
                document.getElementById("filmeAno").value         = filme.ano       || "";
                document.getElementById("filmeDiretor").value     = filme.diretor   || "";
                document.getElementById("filmeSinopse").value     = filme.sinopse   || "";
                document.getElementById("filmePoster").value      = filme.poster    || "";

                modoFilme = "editar";
                tituloPopupFilme.textContent = "Editar Filme";
                abrirPopup("popupFilme");

            } catch (error) {
                console.error(error);
                alert("Erro ao carregar filme para edição.");
            }
        }

        async function salvarEdicaoFilme() {
            await salvarFilme(); // mesma lógica de salvar, usando id preenchido
        }

        async function deletarFilme(id) {
            if (!confirm("Deseja realmente excluir este filme?")) return;

            try {
                const response = await fetch(`/filmes/${id}`, { method: "DELETE" });

                if (!response.ok) {
                    const result = await response.json();
                    alert(result.error || "Erro ao excluir filme.");
                    return;
                }

                alert("Filme excluído com sucesso!");
                carregarFilmes();

            } catch (error) {
                console.error(error);
                alert("Erro ao excluir filme.");
            }
        }

        /* ================== CINEMAS ================== */
        const tbodyCinemas      = document.getElementById("cinemas-tbody");
        const btnAddCinema      = document.getElementById("btnAddCinema");
        const btnSalvarCinema   = document.getElementById("btnSalvarCinema");
        const tituloPopupCinema = document.getElementById("tituloPopupCinema");
        let modoCinema = "criar";

        function limparFormularioCinema() {
            document.getElementById("cinemaId").value       = "";
            document.getElementById("cinemaNome").value     = "";
            document.getElementById("cinemaEndereco").value = "";
            document.getElementById("cinemaFoto").value     = "";
        }

        if (btnAddCinema) {
            btnAddCinema.addEventListener("click", () => {
                modoCinema = "criar";
                tituloPopupCinema.textContent = "Adicionar Cinema";
                limparFormularioCinema();
                abrirPopup("popupCinema");
            });
        }

        if (btnSalvarCinema) {
            btnSalvarCinema.addEventListener("click", async () => {
                if (modoCinema === "criar") {
                    await salvarCinema();
                } else {
                    await salvarEdicaoCinema();
                }
            });
        }

        async function salvarCinema() {
            const id       = document.getElementById("cinemaId").value;
            const nome     = document.getElementById("cinemaNome").value.trim();
            const endereco = document.getElementById("cinemaEndereco").value.trim();
            const foto     = document.getElementById("cinemaFoto").value.trim();

            if (!nome || !endereco) {
                alert("Nome e endereço são obrigatórios!");
                return;
            }

            const data = { nome, endereco, foto };

            try {
                const url = id ? `/cinemas/${id}` : "/cinemas";
                const method = id ? "PUT" : "POST";

                const response = await fetch(url, {
                    method,
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (!response.ok) {
                    alert(result.error || "Erro ao salvar cinema.");
                    return;
                }

                alert(id ? "Cinema atualizado!" : "Cinema cadastrado!");
                fecharPopup("popupCinema");
                carregarCinemas();

            } catch (error) {
                console.error(error);
                alert("Erro ao salvar cinema.");
            }
        }

        async function carregarCinemas() {
            if (!tbodyCinemas) return;

            tbodyCinemas.innerHTML = "<tr><td colspan='4'>Carregando...</td></tr>";

            try {
                const response = await fetch("/cinemas");
                const cinemas = await response.json();

                tbodyCinemas.innerHTML = "";

                if (!cinemas || cinemas.length === 0) {
                    tbodyCinemas.innerHTML = "<tr><td colspan='4'>Nenhum cinema cadastrado.</td></tr>";
                    return;
                }

                cinemas.forEach(cinema => {
                    const tr = document.createElement("tr");

                    tr.innerHTML = `
                        <td>${cinema.nome}</td>
                        <td>${cinema.endereco}</td>
                        <td>
                            ${cinema.foto 
                                ? `<img src="${cinema.foto}" style="width: 60px; height: auto; border-radius: 4px;" />`
                                : "-"
                            }
                        </td>
                        <td>
                            <button class="btn-editar-cinema" data-id="${cinema._id}">Editar</button>
                            <button class="btn-deletar-cinema" data-id="${cinema._id}">Excluir</button>
                        </td>
                    `;

                    tbodyCinemas.appendChild(tr);
                });

            } catch (err) {
                console.error(err);
                tbodyCinemas.innerHTML = "<tr><td colspan='4'>Erro ao carregar cinemas.</td></tr>";
            }
        }

        if (tbodyCinemas) {
            tbodyCinemas.addEventListener("click", async (e) => {
                const btn = e.target;
                const id = btn.getAttribute("data-id");
                if (!id) return;

                if (btn.classList.contains("btn-editar-cinema")) {
                    await editarCinema(id);
                } else if (btn.classList.contains("btn-deletar-cinema")) {
                    await deletarCinema(id);
                }
            });
        }

        async function editarCinema(id) {
            try {
                const response = await fetch(`/cinemas/${id}`);
                const cinema = await response.json();

                document.getElementById("cinemaId").value       = cinema._id;
                document.getElementById("cinemaNome").value     = cinema.nome || "";
                document.getElementById("cinemaEndereco").value = cinema.endereco || "";
                document.getElementById("cinemaFoto").value     = cinema.foto || "";

                modoCinema = "editar";
                tituloPopupCinema.textContent = "Editar Cinema";
                abrirPopup("popupCinema");
            } catch (err) {
                console.error(err);
                alert("Erro ao carregar cinema para edição.");
            }
        }

        async function salvarEdicaoCinema() {
            await salvarCinema();
        }

        async function deletarCinema(id) {
            if (!confirm("Tem certeza que deseja excluir este cinema?")) return;

            try {
                const response = await fetch(`/cinemas/${id}`, { method: "DELETE" });

                if (!response.ok) {
                    const result = await response.json();
                    alert(result.error || "Erro ao excluir cinema.");
                    return;
                }

                alert("Cinema excluído com sucesso!");
                carregarCinemas();

            } catch (error) {
                console.error(error);
                alert("Erro ao excluir cinema.");
            }
        }

        /* ================== CARREGAR DADOS AO ABRIR ================== */
        carregarUsuarios();
        carregarFilmes();
        carregarCinemas();
    });
    </script>
</body>
</html>