<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="IMG/icon.png" class="icon" alt="icon">
    <title>Configurações</title>
    <link rel="stylesheet" href="css/style2.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Open Sans', sans-serif;
            background-color: #ffffff;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 900px;
            margin: 50px auto;
            background: white;
            border-radius: 15px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            padding: 40px;
        }

        .tabs {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .tab-btn {
            background: #f1f1f1;
            border: none;
            padding: 10px 25px;
            border-radius: 30px;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .tab-btn.active {
            background: #c4002f;
            color: white;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
            animation: fadeIn 0.4s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .section-header h2 {
            color: #c4002f;
            margin-bottom: 10px;
        }

        .add-btn {
            background: #c4002f;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            cursor: pointer;
            transition: 0.3s;
        }

        .add-btn:hover {
            background: #a80027;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th, td {
            text-align: left;
            padding: 10px;
            border-bottom: 1px solid #eee;
        }

        th {
            color: #333;
        }

        /* ---------- Popup ---------- */
        .popup {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
            z-index: 999;
        }

        .popup-content {
            background: white;
            border-radius: 15px;
            padding: 30px;
            width: 400px;
            box-shadow: 0 0 15px rgba(0,0,0,0.2);
        }

        .popup-content h3 {
            color: #c4002f;
            margin-bottom: 20px;
            text-align: center;
        }

        .popup-content input,
        .popup-content textarea {
            width: 100%;
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 15px;
        }

        .popup-buttons {
            display: flex;
            justify-content: space-between;
        }

        .popup-buttons button {
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            cursor: pointer;
        }

        .save-btn {
            background: #c4002f;
            color: white;
        }

        .cancel-btn {
            background: #ccc;
        }
    </style>
</head>
<body>
    <header>
        <a href="Index.html">
            <img src="IMG/logo.png" alt="Logo" class="logo" id="logo">
        </a>
        <nav>
            <!-- Menu Lateral -->
            <input type="checkbox" id="check">

            <!-- Botões de controle -->
            <label for="check">
                <i class="fas fa-bars" id="btn"></i>
                <i class="fas fa-times" id="cancel"></i>
            </label>

            <!-- Overlay -->
            <div class="sidebar-overlay" id="overlay"></div>    

            <div class="sidebar">
                <header>
                    <img src="IMG/logo.png" alt="Logo Simoldes" class="logo-sidebar">
                </header>
                    
                <a href="index.html" class="link-sidebar">
                    <i class="fas fa-home"></i>
                    <span>Home</span>
                </a>
                
                <a href="#" class="link-sidebar" onclick="showTable('production')">
                    <i class="fas fa-industry"></i>
                    <span>Favoritos</span>
                </a>
                
                <a href="#" class="link-sidebar" onclick="showTable('finished')">
                    <i class="fas fa-check-circle"></i>
                    <span>Cinemas</span> 
                </a>
                
                <a href="#" class="link-sidebar" onclick="showSettings()">
                    <i class="fas fa-cog"></i>
                    <span>Configurações</span>
                </a>

                <div class="user-section">
                    <div class="user-info">
                        <i class="fas fa-user-circle"></i>
                        <span id="username">Nome do Usuário</span>
                    </div>
                    <a href="#" class="logout-btn" onclick="logout()">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Sair</span>
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <main id="content-area">
        <h2>Configurações do Sistema</h2>
        <div class="container">

            <div class="tabs">
                <button class="tab-btn active" data-tab="usuarios">Usuários</button>
                <button class="tab-btn active" data-tab="cinemas">Cinemas</button>
                <button class="tab-btn" data-tab="filmes">Filmes</button>
            </div>

            <!-- Usuários -->
            <div id="usuarios" class="tab-content active">
                <div class="section-header">
                    <h2>Gerenciar Usuários</h2>
            <button class="add-btn" onclick="novoUsuario()">Adicionar Usuário</button>       
                 </div>
                <table>
                    <thead>
                        <tr>
                            <th>Usuário</th>
                            <th>E-mail</th>
                            <th>Senha</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <!-- Cinemas -->
            <div id="cinemas" class="tab-content active">
                <div class="section-header">
                    <h2>Gerenciar Cinemas</h2>
                    <button class="add-btn" onclick="novoCinema()">Adicionar Cinema</button>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Endereço</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <!-- Filmes -->
            <div id="filmes" class="tab-content">
                <div class="section-header">
                    <h2>Gerenciar Filmes</h2>
                    <button class="add-btn" onclick="abrirPopup('popupFilme')">Adicionar Filme</button>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Descrição</th>
                            <th>Gênero</th>
                            <th>Ano</th>
                            <th>Diretor</th>
                            <th>Sinopse</th>
                            <th>Poster</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <!-- Popups -->
        <div class="popup" id="popupUsuario">
            <div class="popup-content">
                <h3>Adicionar Usuário</h3>
                <input id="usuarioNome" type="text" placeholder="Nome de Usuário">
                <input id="usuarioEmail" type="email" placeholder="E-mail">
                <input id="usuarioSenha" type="password" placeholder="Senha">
                <input id="usuarioId" type="hidden" placeholder="Editar">
                <div class="popup-buttons">
                    <button class="cancel-btn" onclick="fecharPopup('popupUsuario')">Cancelar</button>
                    <button class="save-btn" onclick="CriarUsuario()">Salvar</button>
                </div>
            </div>
        </div>

        <div class="popup" id="popupCinema">
            <div class="popup-content">
                <h3>Adicionar Cinema</h3>
                <input id="cinemaId" type="hidden"> <!-- ESSE INPUT É OBRIGATÓRIO -->
                <input id="cinemaNome" type="text" placeholder="Nome do Cinema">
                <input id="cinemaEndereco" type="text" placeholder="Localização">
                <div class="popup-buttons">
                    <button class="cancel-btn" onclick="fecharPopup('popupCinema')">Cancelar</button>
                    <button class="save-btn" onclick="salvarCinema()">Salvar</button>
                </div>
            </div>
        </div>


        <div class="popup" id="popupFilme">
            <div class="popup-content">
                <h3>Adicionar Filme</h3>
                <input type="text" placeholder="Título">
                <input type="text" placeholder="Descrição">
                <input type="text" placeholder="Gênero">
                <input type="text" placeholder="Ano">
                <input type="text" placeholder="Diretor">
                <textarea rows="3" placeholder="Sinopse"></textarea>
                <input type="file" accept="image/*">
                <div class="popup-buttons">
                    <button class="cancel-btn" onclick="fecharPopup('popupFilme')">Cancelar</button>
                    <button class="save-btn">Salvar</button>
                </div>
            </div>
        </div>
    </main>

    <footer>
        <p>&copy; PopFlix.</p>
    </footer>

    <script>
        // ---------- Menu lateral ----------
        const check = document.getElementById('check');
        const overlay = document.getElementById('overlay');
        const sidebar = document.querySelector('.sidebar');
        const btn = document.getElementById('btn');

        overlay.addEventListener('click', function() {
            check.checked = false;
            updateSidebarState();
        });

        function updateSidebarState() {
            if (check.checked) {
                overlay.style.display = 'block';
                setTimeout(() => {
                    overlay.style.opacity = '1';
                    overlay.style.visibility = 'visible';
                }, 10);
            } else {
                overlay.style.opacity = '0';
                overlay.style.visibility = 'hidden';
                setTimeout(() => {
                    overlay.style.display = 'none';
                }, 300);
            }
        }

        check.addEventListener('change', updateSidebarState);

        document.addEventListener('click', function(e) {
            if (check.checked && 
                !sidebar.contains(e.target) && 
                e.target !== check && 
                e.target !== btn && 
                !btn.contains(e.target)) {
                setTimeout(() => {
                    check.checked = false;
                    updateSidebarState();
                }, 10);
            }
        });

    </script>
    <script>
        // ---------- Tabs ----------
        const tabs = document.querySelectorAll('.tab-btn');
        const contents = document.querySelectorAll('.tab-content');

        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                tabs.forEach(t => t.classList.remove('active'));
                contents.forEach(c => c.classList.remove('active'));
                tab.classList.add('active');
                document.getElementById(tab.dataset.tab).classList.add('active');
            });
        });

        // ---------- Popups ----------
        function abrirPopup(id) {
            document.getElementById(id).style.display = 'flex';
        }

        function fecharPopup(id) {
            document.getElementById(id).style.display = 'none';
        }

        window.onclick = function(e) {
            const popups = document.querySelectorAll('.popup');
            popups.forEach(p => {
                if (e.target === p) p.style.display = 'none';
            });
        };
    </script>
    <script>
async function CriarUsuario() {
    const nome = document.getElementById("usuarioNome").value;
    const email = document.getElementById("usuarioEmail").value;
    const senha = document.getElementById("usuarioSenha").value;

    const data = { nome, email, senha };

        if (!nome || !email || !senha) {
        alert("Preencha todos os campos antes de salvar.");
        return;
        }
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
        alert("E-mail inválido.");
        return;
        }

    // Senha mínima
    if (senha.length < 6) {
        alert("A senha deve ter no mínimo 6 caracteres.");
        return;
    }
    
    try {
        const response = await fetch("/users", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(data)
    });


        const result = await response.json();
        console.log(result);

        alert("Usuário cadastrado com sucesso!");
        fecharPopup('popupUsuario');
        carregarUsuarios();
    } catch (error) {
        console.error(error);
        alert("Erro ao cadastrar usuário");
    }
}
</script>
<script>
async function carregarUsuarios() {
    const tbody = document.querySelector("#usuarios tbody");

    tbody.innerHTML = "<tr><td colspan='4'>Carregando...</td></tr>";

    try {
        const response = await fetch("/users");
        const users = await response.json();

        tbody.innerHTML = "";

        users.forEach(user => {
            const tr = document.createElement("tr");
            tr.innerHTML = `
                <td>${user.nome}</td>
                <td>${user.email}</td>
                <td>${"*".repeat(user.senha.length)}</td>
                <td>
                    <button onclick="editar('${user._id}')">Editar</button>
                    <button onclick="deletar('${user._id}')">Excluir</button>
                </td>
            `;
            tbody.appendChild(tr);
        });

    } catch (err) {
        console.error(err);
        tbody.innerHTML = "<tr><td colspan='4'>Erro ao carregar usuários</td></tr>";
    }
}

// carregar assim que a página abrir
document.addEventListener("DOMContentLoaded", carregarUsuarios);
</script>
<script>
function editar(id) {
    fetch(`/users/${id}`)
        .then(res => res.json())
        .then(user => {
            console.log("Retorno do backend:", user);  // <-- ESSENCIAL
            document.getElementById("usuarioId").value = user._id;
            document.getElementById("usuarioNome").value = user.nome;
            document.getElementById("usuarioEmail").value = user.email;
            document.getElementById("usuarioSenha").value = "*".repeat(user.senha.length);

            document.querySelector("#popupUsuario h3").innerText = "Editar Usuário";
            document.querySelector("#popupUsuario .save-btn").setAttribute("onclick", "salvarEdicao()");

            abrirPopup("popupUsuario");
        });
}
</script>
<script>
async function salvarEdicao() {
    const id = document.getElementById("usuarioId").value;

    const nome = document.getElementById("usuarioNome").value.trim();
    const email = document.getElementById("usuarioEmail").value.trim();
    const senha = document.getElementById("usuarioSenha").value.trim();

    // --------- VALIDAÇÃO NO FRONT ---------
    if (!nome || !email || !senha) {
        alert("Todos os campos são obrigatórios!");
        return; // <-- NÃO ENVIA PRO BACK-END
    }

    try {
        const response = await fetch(`/users/${id}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ nome, email, senha })
        });

        const result = await response.json();

        // --------- TRATAR ERRO DO BACK-END ---------
        if (!response.ok) {
            alert(result.error || "Erro ao atualizar.");
            return;
        }

        // --------- SUCESSO ---------
        alert("Usuário atualizado!");
        fecharPopup("popupUsuario");
        carregarUsuarios();

    } catch (error) {
        alert("Erro ao atualizar usuário.");
        console.error(error);
    }
}

</script>
<script> function novoUsuario() {
    document.getElementById("usuarioId").value = "";
    document.getElementById("usuarioNome").value = "";
    document.getElementById("usuarioEmail").value = "";
    document.getElementById("usuarioSenha").value = "";

    document.querySelector("#popupUsuario h3").innerText = "Adicionar Usuário";
    document.querySelector("#popupUsuario .save-btn")
        .setAttribute("onclick", "CriarUsuario()");

    abrirPopup("popupUsuario");
}
</script>

<script> 
    async function deletar(id) {
    if (!confirm("Tem certeza que deseja excluir este usuário?")) return;

    const response = await fetch(`http://localhost:8088/users/${id}`, {
        method: "DELETE"
    });

    if (response.ok) {
        alert("Usuário excluído com sucesso!");
        carregarUsuarios(); // Atualiza a tabela
    } else {
        alert("Erro ao excluir usuário.");
    }
}
</script>

<script>
async function salvarCinema() {
    const nome = document.getElementById("cinemaNome").value;
    const endereco = document.getElementById("cinemaEndereco").value;

    const data = { nome, endereco};

    if (!nome || !endereco) {
        alert("Todos os campos são obrigatórios!");
        return;
    }

    try {
        const response = await fetch("/cinemas", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data)
        });

        const result = await response.json();

        if (!response.ok) {
            alert(result.error || "Erro ao cadastrar cinema");
            return;
        }

        alert("Cinema cadastrado!");
        fecharPopup("popupCinema");
        carregarCinemas();

    } catch (error) {
        console.error(error);
        alert("Erro ao cadastrar cinema");
    }
}
</script>
<script>
async function carregarCinemas() {
    const tbody = document.querySelector("#cinemas tbody");

    tbody.innerHTML = "<tr><td colspan='4'>Carregando...</td></tr>";

    try {
        const response = await fetch("/cinemas");
        const cinemas = await response.json();

        tbody.innerHTML = "";

        cinemas.forEach(cinema => {
            const tr = document.createElement("tr");

            tr.innerHTML = `
                <td>${cinema.nome}</td>
                <td>${cinema.endereco}</td>
                <td>
                    <button onclick="editarCinema('${cinema._id}')">Editar</button>
                    <button onclick="deletarCinema('${cinema._id}')">Excluir</button>
                </td>
            `;

            tbody.appendChild(tr);
        });

    } catch (err) {
        console.error(err);
        tbody.innerHTML = "<tr><td colspan='4'>Erro ao carregar cinemas</td></tr>";
    }
}

document.addEventListener("DOMContentLoaded", carregarCinemas);
</script>
<script>
      function novoCinema() {
    let cinemaIdElem = document.getElementById("cinemaId");
    let cinemaNomeElem = document.getElementById("cinemaNome");
    let cinemaEnderecoElem = document.getElementById("cinemaEndereco");

    console.log({ cinemaIdElem, cinemaNomeElem, cinemaEnderecoElem });

    if (cinemaIdElem) cinemaIdElem.value = "";
    if (cinemaNomeElem) cinemaNomeElem.value = "";
    if (cinemaEnderecoElem) cinemaEnderecoElem.value = "";

    let popupH3 = document.querySelector("#popupCinema h3");
    if (popupH3) popupH3.innerText = "Adicionar Cinema";

    let saveBtn = document.querySelector("#popupCinema .save-btn");
    if (saveBtn) saveBtn.setAttribute("onclick", "salvarCinema()");

    abrirPopup("popupCinema");
};
   
   
</script>
<script>
function editarCinema(id) {
    fetch(`/cinemas/${id}`)
        .then(res => res.json())
        .then(cinema => {
            console.log("Retorno do backend:", cinema);
            document.getElementById("cinemaId").value = cinema._id;
            document.getElementById("cinemaNome").value = cinema.nome;
            document.getElementById("cinemaEndereco").value = cinema.endereco;

            document.querySelector("#popupCinema h3").innerText = "Editar Cinema";
            document.querySelector("#popupCinema .save-btn")
                .setAttribute("onclick", "salvarEdicaoCinema()");

            abrirPopup("popupCinema");
        });
}
</script>
<script>
async function salvarEdicaoCinema() {
    const id = document.getElementById("cinemaId").value;

    const nome = document.getElementById("cinemaNome").value.trim();
    const endereco = document.getElementById("cinemaEndereco").value.trim();

    if (!nome || !endereco) {
        alert("Todos os campos são obrigatórios!");
        return;
    }

    try {
        const response = await fetch(`/cinemas/${id}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ nome, endereco})
        });

        const result = await response.json();

        if (!response.ok) {
            alert(result.error || "Erro ao atualizar cinema.");
            return;
        }

        alert("Cinema atualizado!");
        fecharPopup("popupCinema");
        carregarCinemas();

    } catch (error) {
        alert("Erro ao atualizar cinema.");
        console.error(error);
    }
}
</script>
<script>
async function deletarCinema(id) {
    if (!confirm("Tem certeza que deseja excluir este cinema?")) return;

    const response = await fetch(`/cinemas/${id}`, {
        method: "DELETE"
    });

    if (response.ok) {
        alert("Cinema excluído com sucesso!");
        carregarCinemas();
    } else {
        alert("Erro ao excluir cinema.");
    }
}
</script>
</body>
