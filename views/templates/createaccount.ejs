<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="">
    <title>PopFlix</title>
    <link rel="stylesheet" href="/views/static/CSS/style.css">
    <style>
        body {
			position: relative;
			overflow: hidden;
			}
        main{
            max-height: 100%;
            overflow: hidden;
            background: linear-gradient(to bottom, #0E0E0E 0%, #3A3A3A 40%, #7A7A7A 70%, #B3B3B3 100%);
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
        }	
        aside{
            display: flex;
            justify-content: right;
            align-items: center;
            border-bottom: 10px solid #ccc;
            background-color: #0E0E0E;
            border: none;
            color: white;
            box-shadow: 0px px 10px rgba(0, 10, 0, 0.25);
            transition: background-color 0.3s ease, transform 0.3s ease;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
        </header>
        <aside>
            <!-- Conteúdo do aside, se necessário -->
        </aside>
        <main>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const body = document.querySelector("body");

                    // Função para gerar uma bolinha
                    function createBall() {
                        const ball = document.createElement("div");
                        ball.classList.add("ball");

                        // Definir tamanho aleatório
                        const size = Math.random() * 20 + 10 + "px";
                        ball.style.width = size;
                        ball.style.height = size;

                        // Posição horizontal aleatória
                        ball.style.left = Math.random() * 100 + "vw";

                        // Diferentes durações de animação
                        ball.style.animationDuration = Math.random() * 5 + 8 + "s";

                        body.appendChild(ball);

                        // Remover a bolinha após a animação terminar
                        setTimeout(() => {
                            ball.remove();
                        }, 12000); // Duração um pouco maior que a animação
                    }

                    // Criar bolinhas continuamente
                    setInterval(createBall, 500); // Cria uma bolinha a cada 500ms
                });
            </script>
            <div class="form-cadastro">
                <form action="{% url 'login' %}" method="POST">
					<br>
					<div class="cadastrese"></div>
					<br>
					<div class="imgcadastro">
						<img src="/views/static/IMG/logo.png" id="logocadastro" alt="logo">
					</div>
					<br>
					<div class="box">
						<div class="input-data">
							<input type="text" name="username" required placeholder=" " />
							<label>Usuário</label>
						</div>
					</div>
                    <div class="box">
						<div class="input-data">
							<input type="text" name="username" required placeholder=" " />
							<label>E-mail</label>
						</div>
					</div>
					<div class="box">
						<div class="input-data">
							<input type="password" name="password" required placeholder=" " />
							<label>Senha</label>
						</div>
					</div> 
					<br>
					<input type="submit" id="btcadastro" value="Criar Conta "><br><br>
                    <div class="esqueci">
						<a id="esqueci" href="{% url 'esqueci_senha' %}">Já tem uma conta no PopFlix? Faça login.</a>
					</div>
				</form>				
            </div>
        </main>
        <footer>
            <div class="boxfoo">
                
            </div>
        </footer>
    </div>
</body>
</html>
