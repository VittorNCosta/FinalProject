<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PopFlix - Home</title>
    <link rel="stylesheet" href="/css/style2.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body>

<header>
    <a href="/home">
        <img src="/IMG/logo.png" alt="Logo" class="logo" id="logo">
    </a>

    <nav>
        <input type="checkbox" id="check">

        <label for="check">
            <i class="fas fa-bars" id="btn"></i>
            <i class="fas fa-times" id="cancel"></i>
        </label>

        <div class="sidebar-overlay" id="overlay"></div>

        <div class="sidebar">

            <header>
                <img src="/IMG/logo.png" class="logo-sidebar">
            </header>

            <a href="/home" class="link-sidebar">
                <i class="fas fa-home"></i><span>Home</span>
            </a>

            <a href="/favoritos" class="link-sidebar">
                <i class="fas fa-heart"></i><span>Favoritos</span>
            </a>

            <a href="/lista-cinemas" class="link-sidebar">
                <i class="fas fa-film"></i><span>Cinemas</span>
            </a>

            <a href="/config" class="link-sidebar">
                <i class="fas fa-cog"></i><span>Configurações</span>
            </a>

            <div class="user-section">
                <div class="user-info">
                    <i class="fas fa-user-circle"></i>
                    <span id="username"><%= currentUser.username %></span>
                </div>

                <a href="/auth/logout" class="logout-btn">
                    <i class="fas fa-sign-out-alt"></i><span>Sair</span>
                </a>
            </div>

        </div>
    </nav>
</header>

<main id="content-area">

    <section class="boas-vindas">
        <h2>Descubra os filmes que estão em alta abaixo!</h2>
    </section>

    <section class="categorias">
        <div class="botoes-categorias">
            <button class="ativo">Romance</button>
            <button>Ação</button>
            <button>Comédia</button>
            <button>Drama</button>
            <button>Ficção</button>
        </div>
    </section>

    <section class="filmes">
        <% if (filmes && filmes.length > 0) { %>
            <% filmes.forEach(filme => { %>
                <a href="/filmes/detalhes/<%= filme._id %>" class="filme-card">
                    <img src="<%= filme.poster %>" alt="<%= filme.titulo %>">
                    <h4><%= filme.titulo %></h4>
                    <p><%= filme.diretor %></p>
                </a>
            <% }) %>
        <% } else { %>
            <p>Nenhum filme encontrado.</p>
        <% } %>
    </section>

</main>

<footer>
    <p>&copy; PopFlix</p>
</footer>

<script>
    const check = document.getElementById('check');
    const overlay = document.getElementById('overlay');
    const sidebar = document.querySelector('.sidebar');
    const btn = document.getElementById('btn');

    overlay.addEventListener('click', function () {
        check.checked = false;
        updateSidebarState();
    });

    function updateSidebarState() {
        overlay.style.display = check.checked ? 'block' : 'none';
        setTimeout(() => {
            overlay.style.opacity = check.checked ? '1' : '0';
        }, 10);
    }
</script>

<script src="/JS/config.js"></script>

</body>
</html>
