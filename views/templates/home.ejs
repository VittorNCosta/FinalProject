<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="IMG/icon.png" class="icon" alt="icon">
    <title>Home</title>
    <link rel="stylesheet" href="/views/static/css/style2.css"
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Estilos p    ara os filtros */
        .filtro-container {
            background-color: #f5f5f5;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
            display: none; /* Inicialmente oculto */
            flex-wrap: wrap;
            gap: 15px;
            align-items: flex-end;
        }

        .filtro-item {
            display: flex;
            flex-direction: column;
            min-width: 150px;
        }

        .filtro-select, .filtro-input {
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 14px;
        }

        .btn-filtrar, .btn-limpar {
            padding: 8px 16px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-filtrar {
            background-color: #4CAF50;
            color: white;
        }

        .btn-limpar {
            background-color: #f44336;
            color: white;
            margin-left: 10px;
        }

        .btn-filtrar:hover {
            background-color: #45a049;
        }

        .btn-limpar:hover {
            background-color: #d32f2f;
        }

        label {
            margin-bottom: 5px;
            font-weight: bold;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <!-- Seu cabeçalho e menu lateral permanecem iguais -->
    <header>
        <a href="Index.html">
            <img src="/views/static/IMG/logo.png" alt="Logo" class="logo" id="logo">
        </a>
        <nav>
            <!-- Menu Lateral -->
            <input type="checkbox" id="check">

            <!-- Botões de controle - ambos na mesma posição -->
            <label for="check">
            <i class="fas fa-bars" id="btn"></i>
            <i class="fas fa-times" id="cancel"></i>
            </label>

            <!-- Overlay -->
            <div class="sidebar-overlay" id="overlay"></div>    

            <div class="sidebar">
            <header>
                <img src="/views/static/IMG/logo.png" alt="Logo Simoldes" class="logo-sidebar">
            </header>
                
            <a href="index.html" class="link-sidebar">
                <i class="fas fa-home"></i>
                <span>Home</span>
            </a>
            
            <a href="#" class="link-sidebar" onclick="showTable('production')">
                <i class="fas fa-industry"></i>
                <span >Favoritos</span>
            </a>
            
            <a href="#" class="link-sidebar" onclick="showTable('finished')">
                <i class="fas fa-check-circle"></i>
                <span >Cinemas</span> 
            </a>
            
            <a href="#" class="link-sidebar" onclick="showSettings()">
                <i class="fas fa-cog"></i>
                <span>Configurações</span>
            </a>

            <div class="user-section">
                <div class="user-info">
                    <i class="fas fa-user-circle"></i>
                    <span id="username">Nome do Usuário</span>
                </div>
                <a href="#" class="logout-btn" onclick="logout()">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Sair</span>
                </a>
            </div>

            </div>
        </nav>
    </header>

    <main id="content-area">
        <section class="boas-vindas">
        <h2>Descubra os filmes que estão em alta abaixo!</h2>
        </section>

        <section class="categorias">
        <div class="botoes-categorias">
            <button class="ativo">Romance</button>
            <button>Ação</button>
            <button>Comédia</button>
            <button>Drama</button>
            <button>Ficção</button>
        </div>
        </section>

        <section class="filmes">
        <div class="filme-card">
            <img src="/views/static/IMG/simplesmenteacontece.jpg" alt="Simplesmente Acontece">
            <h4>Simplesmente Acontece</h4>
            <p>Christian Ditter</p>
        </div>
        </section>
    </main>

    <footer>
        <p>&copy; PopFlix.</p>
    </footer>

    <script>
            // Configuração do menu lateral
            const check = document.getElementById('check');
            const overlay = document.getElementById('overlay');
            const sidebar = document.querySelector('.sidebar');
            const btn = document.getElementById('btn');

            overlay.addEventListener('click', function() {
                check.checked = false;
                updateSidebarState();
            });

            function updateSidebarState() {
                if (check.checked) {
                    overlay.style.display = 'block';
                    setTimeout(() => {
                        overlay.style.opacity = '1';
                        overlay.style.visibility = 'visible';
                    }, 10);
                } else {
                    overlay.style.opacity = '0';
                    overlay.style.visibility = 'hidden';
                    setTimeout(() => {
                        overlay.style.display = 'none';
                    }, 300);
                }
            }

            check.addEventListener('change', updateSidebarState);

            document.addEventListener('click', function(e) {
                if (check.checked && 
                    !sidebar.contains(e.target) && 
                    e.target !== check && 
                    e.target !== btn && 
                    !btn.contains(e.target)) {
                    setTimeout(() => {
                        check.checked = false;
                        updateSidebarState();
                    }, 10);
                }
            });
    </script>
    <script src="JS/config.js"></script>
</body>
</html>